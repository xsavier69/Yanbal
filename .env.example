# URL y llave pública de tu proyecto de Supabase
# (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correo de la cuenta admin. Debe coincidir EXACTAMENTE con:
# 1) El correo de la cuenta que crees en Supabase Auth -> Users
# 2) El correo que pongas dentro de supabase/schema.sql en la función is_admin()
# Además, el panel solo se muestra a esta cuenta.
ADMIN_EMAIL=

# URL pública del sitio ya desplegado. Necesaria para que el enlace se vea
# bien al compartirlo por WhatsApp. Ejemplo: https://mitienda.vercel.app
# En Vercel debe guardarse como "Config", NO como "Secret".
NEXT_PUBLIC_SITE_URL=

# --- Opcionales ---

# Texto secreto para el freno anti-spam del formulario. Sirve para que la
# dirección IP de quien escribe NUNCA se guarde en claro. Pon cualquier
# frase larga e inventada.
LEAD_SALT=

# Aviso por correo cuando llega una persona interesada (https://resend.com).
# Si los dejas vacíos no pasa nada: el panel siempre muestra las personas
# nuevas. Sin estos tres, el correo simplemente no se envía.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
