# URL y llave pública de tu proyecto de Supabase
# (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correo de la cuenta admin (Amada). Debe coincidir EXACTAMENTE con:
# 1) El correo de la cuenta que crees en Supabase Auth -> Users
# 2) El correo que pongas dentro de supabase/schema.sql en la función is_admin()
ADMIN_EMAIL=

# Opcional: URL pública del sitio ya desplegado (mejora las vistas previas
# al compartir el link por WhatsApp). Ejemplo: https://mitienda.vercel.app
NEXT_PUBLIC_SITE_URL=
